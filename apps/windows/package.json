{
  "name": "@usageapp/windows",
  "version": "0.1.0",
  "private": true,
  "description": "Windows tray and desktop widget for UsageApp.",
  "author": "UsageApp",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "concurrently --kill-others-on-fail \"pnpm run dev:renderer\" \"pnpm run dev:desktop\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:desktop": "pnpm run build:main && wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "pnpm run clean && pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsup --config tsup.config.ts",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "package": "pnpm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@usageapp/core": "workspace:*",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.usageapp.windows",
    "productName": "UsageApp",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "UsageApp-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  }
}
