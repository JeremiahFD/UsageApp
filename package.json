{
  "name": "usageapp",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "MIT",
  "description": "A privacy-first Codex and Claude usage monitor for Windows, with a Codex Android companion.",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "pnpm --filter @usageapp/windows dev",
    "dev:windows": "pnpm --filter @usageapp/windows dev",
    "dev:android": "pnpm --filter @usageapp/android start",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "build:windows": "pnpm --filter @usageapp/windows build",
    "package:windows": "pnpm --filter @usageapp/windows package",
    "build:android": "pnpm --filter @usageapp/android apk"
  },
  "devDependencies": {
    "@usageapp/core": "workspace:*",
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
